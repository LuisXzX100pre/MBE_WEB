generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String               @id @default(cuid())
  username            String               @unique
  email               String?              @unique
  phone               String?
  password            String
  role                Role                 @default(CLIENTE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  cart                Cart?
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
  communityComments   CommunityComment[]
  communityWheelSpins CommunityWheelSpin[]
  communityTickets    CommunityTicket[]
  communityMembership CommunityMembership?
  communityInviteRedemption CommunityInviteRedemption?
  communityAccessAttempts CommunityAccessAttempt[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum Role {
  ADMIN
  CLIENTE
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

model Product {
  id              String         @id @default(cuid())
  name            String
  description     String?
  price           Float
  stock           Int            @default(0)
  weightKg        Float          @default(0.35)
  lengthCm        Int            @default(30)
  widthCm         Int            @default(24)
  heightCm        Int            @default(4)
  shipsSeparately Boolean        @default(false)
  status          ProductStatus  @default(ACTIVE)
  dropName        String?
  releaseAt       DateTime?
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])
  images          ProductImage[]
  sizes           ProductSize[]
  homeHeroImageUrl String?
  colors          ProductColor[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model ProductSize {
  id        String  @id @default(cuid())
  size      Size
  stock     Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size])
}

model ProductColor {
  id         String @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  swatchHex  String?
  order      Int @default(0)
  active     Boolean @default(true)
  images     ProductColorImage[]
  sizeStocks ProductColorSize[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId, order])
}

model ProductColorImage {
  id      String @id @default(cuid())
  colorId String
  color   ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)
  url     String
  order   Int @default(0)

  @@index([colorId, order])
}

model ProductColorSize {
  id      String @id @default(cuid())
  colorId String
  color   ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)
  size    Size
  stock   Int @default(0)

  @@unique([colorId, size])
}

enum Size {
  S
  M
  L
  XL
}

enum ProductStatus {
  ACTIVE
  COMING_SOON
  INACTIVE
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  order     Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  quantity  Int     @default(1)
  size      Size?
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  productColorId String?
  productColor ProductColor? @relation(fields: [productColorId], references: [id], onDelete: Restrict)
  variantKey String

  @@unique([cartId, productId, variantKey])
  @@index([productColorId])
}

model Order {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  subtotal     Float  @default(0)
  shippingCost Float  @default(0)
  total        Float
  currency     String @default("MXN")

  status OrderStatus @default(PENDING)

  shippingAddress      String?
  shippingFullName     String?
  shippingPhone        String?
  shippingEmail        String?
  shippingPostalCode   String?
  shippingState        String?
  shippingCity         String?
  shippingNeighborhood String?
  shippingStreet       String?
  shippingExtNumber    String?
  shippingIntNumber    String?
  shippingReference    String?
  shippingCountry      String  @default("MX")

  shippingCarrier        String?
  shippingService        String?
  shippingRateId         String?
  shippingQuotationId    String?
  shippingBucket         String?
  shippingEstimatedDays  Int?
  shippingTrackingNumber String?
  shippingTrackingUrl    String?
  shippingLabelUrl       String?
  shippingQuoteJson      Json?
  skydropxShipmentId     String?

  inventoryDiscounted Boolean @default(false)

  items   OrderItem[]
  payment Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int
  unitPrice Float
  size      Size?
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  productColorId String?
  productColor ProductColor? @relation(fields: [productColorId], references: [id], onDelete: Restrict)
  colorName String?

  @@index([productColorId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String        @default("stripe")
  status            PaymentStatus @default(PENDING)
  transactionId     String?
  preferenceId      String?
  paymentIntentId   String?       @unique
  paymentMethodId   String?
  payerEmail        String?
  receiptEmail      String?
  externalReference String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum CommunityMediaType {
  IMAGE
  VIDEO
}

model CommunityPost {
  id           String             @id @default(cuid())
  title        String
  description  String
  mediaUrl     String
  mediaType    CommunityMediaType
  thumbnailUrl String?
  published    Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  comments     CommunityComment[]
  media        CommunityPostMedia[]

  @@index([published, createdAt])
}

model CommunityPostMedia {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  url       String
  order     Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([postId, order])
}

model CommunityComment {
  id        String        @id @default(cuid())
  userId    String
  postId    String
  text      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId])
}

model CommunityWheelCampaign {
  title        String?
  subtitle     String?
  description  String?
  note         String?
  prizeWeights Json?
  id        String               @id @default(cuid())
  name      String
  active    Boolean              @default(false)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  spins     CommunityWheelSpin[]

  @@index([active, createdAt])
}

model CommunityWheelSpin {
  id              String                 @id @default(cuid())
  userId          String
  campaignId      String
  discountPercent Int
  createdAt       DateTime               @default(now())
  usedAt          DateTime?
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign        CommunityWheelCampaign @relation(fields: [campaignId], references: [id])

  @@unique([userId, campaignId])
  @@index([campaignId, createdAt])
}

model CommunityEvent {
  id          String            @id @default(cuid())
  title       String
  description String
  active      Boolean           @default(false)
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  tickets     CommunityTicket[]

  @@index([active, startsAt])
}

model CommunityTicket {
  id              String         @id @default(cuid())
  eventId         String
  userId          String
  discountPercent Int
  code            String         @unique
  createdAt       DateTime       @default(now())
  expiresAt       DateTime?
  usedAt          DateTime?
  event           CommunityEvent @relation(fields: [eventId], references: [id])
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([eventId, createdAt])
}

model CommunityMembership {
  id         String   @id @default(cuid())
  userId     String   @unique
  joinedAt   DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([joinedAt])
}

enum CommunityInviteType {
  INDIVIDUAL
  CAMPAIGN
}

model CommunityInvite {
  id          String @id @default(cuid())
  name        String
  codeHash    String @unique
  type        CommunityInviteType
  maxUses     Int
  uses        Int @default(0)
  active      Boolean @default(true)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  redemptions CommunityInviteRedemption[]

  @@index([createdAt, id])
}

model CommunityInviteRedemption {
  id         String @id @default(cuid())
  inviteId   String
  userId     String @unique
  redeemedAt DateTime @default(now())
  invite     CommunityInvite @relation(fields: [inviteId], references: [id], onDelete: Restrict)
  user       User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([inviteId, redeemedAt, id])
}

model CommunityAccessAttempt {
  id        String @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
